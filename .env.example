# ---------------------------------------------------------------------------
# ReggieSpace Social Studio — environment template
# Copy to .env (root, for docker-compose) and apps/web/.env (for local dev).
# Never commit real values; on dokploy these come from the project's secrets.
# ---------------------------------------------------------------------------

# Database (Postgres)
POSTGRES_USER=giq
POSTGRES_PASSWORD=giq_dev_password
POSTGRES_DB=giq_studio
DATABASE_URL=postgresql://giq:giq_dev_password@localhost:5432/giq_studio

# Redis
REDIS_URL=redis://localhost:6379

# Auth. SESSION_SECRET also derives the key that encrypts stored API keys and
# signs render tokens — rotating it invalidates both.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Used by `pnpm --filter @giq/web db:seed` to create the sign-in account.
OPERATOR_EMAIL=you@example.com
OPERATOR_PASSWORD=

# ---------------------------------------------------------------------------
# AI providers. These are the platform defaults; a workspace can override any
# of them with its own key in Settings → Integrations.
# ---------------------------------------------------------------------------

# Copy generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Image generation for template image slots
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev

# Narration for Reels and Stories. Voices are picked per post in the Voice tab.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Publishing. Bring-your-own: each workspace connects its own key in Settings.
# The values here are only the fallback for the owner workspace.
# ---------------------------------------------------------------------------

# Postiz API key: Postiz → Settings → Developers → Public API.
# Base URL is the Postiz backend (the public API is served at `${base}/public/v1`);
# for a single-domain self-hosted deploy the backend is proxied under /api.
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://postiz.reggiespace.ca/api

# Seed-only: channel ids from GET ${POSTIZ_BASE_URL}/public/v1/integrations.
# After seeding, channel ids are managed in Settings → Channels.
POSTIZ_CHANNEL_US_FACEBOOK=
POSTIZ_CHANNEL_US_INSTAGRAM=
POSTIZ_CHANNEL_BR_FACEBOOK=
POSTIZ_CHANNEL_BR_INSTAGRAM=

# ---------------------------------------------------------------------------
# Worker. It screenshots the web app's own /render/slide route, so WEB_BASE_URL
# must be reachable *from the worker container*, not from a browser.
# ---------------------------------------------------------------------------
WORKER_BASE_URL=http://localhost:8000
WORKER_SHARED_SECRET=change-me-internal-worker-secret
WEB_BASE_URL=http://localhost:3000

# --- Media storage ---
STORAGE_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media

STORAGE_BACKEND=local            # local | s3
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=garage
MEDIA_S3_ENDPOINT=
MEDIA_PUBLIC_BASE_URL=           # optional CDN base; else <endpoint>/<bucket>/<key>
AWS_ACCESS_KEY_ID=               # Garage key (write to media prefixes only)
AWS_SECRET_ACCESS_KEY=
