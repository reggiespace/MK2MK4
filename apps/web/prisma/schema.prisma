// ReggieSpace Social Studio — data model.
//
// Workspace-scoped from the start: every tenant-owned row hangs off a Workspace
// so multi-tenant auth and billing drop in later without another migration.
// Content follows the template manifests — a post stores its slide sequence as
// kind + slot values, not fixed columns, because the manifests own that shape.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reserved for the billing phase — unused until Stripe is wired.
  plan               String  @default("free")
  stripeCustomerId   String?
  freePostsRemaining Int     @default(5)

  users        User[]
  accounts     BrandAccount[]
  integrations Integration[]
  assets       Asset[]
  posts        Post[]
  apiTokens    ApiToken[]
  jobs         Job[]
}

model User {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())

  apiTokens ApiToken[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Integrations — per-workspace credentials (bring-your-own publishing keys).
// AI providers fall back to platform env keys when a workspace has none.
// ---------------------------------------------------------------------------

enum Provider {
  postiz
  buffer
  zernio
  fal
  elevenlabs
  openai
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    Provider

  /// Encrypted at rest by lib/crypto — never stored or logged in plaintext.
  apiKey     String
  baseUrl    String?
  connected  Boolean   @default(true)
  lastSyncAt DateTime?
  meta       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([workspaceId, provider])
}

// ---------------------------------------------------------------------------
// Brand accounts — the identity a post is created for
// ---------------------------------------------------------------------------

enum Locale {
  en
  pt_BR
}

enum ReadingLevel {
  grade5
  grade7
  grade9
}

model BrandAccount {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  key      String
  name     String
  locale   Locale
  handle   String
  initials String

  /// CSS gradient for the monogram mark in the sidebar and account cards.
  mark String @default("linear-gradient(135deg,#3b5a78,#5c7556)")
  /// Brand accent fed to every template; the accent guardrail keeps it legible.
  accent   String @default("#5c7556")
  timezone String @default("America/Toronto")

  // Brand voice — drives every AI generation for this account.
  voiceDescription String       @default("") @db.Text
  tones            String[]     @default([])
  readingLevel     ReadingLevel @default(grade7)
  claimsGuardrail  Boolean      @default(true)

  /// Where the post-level download CTA points (caption + first comment).
  downloadUrl String?

  logoAssetId String?
  logoAsset   Asset?  @relation("BrandLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels Channel[]
  pillars  Pillar[]
  ideas    Idea[]
  assets   Asset[]   @relation("AccountAssets")
  posts    Post[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

enum Platform {
  instagram
  facebook
  tiktok
  youtube
  linkedin
  x
}

model Channel {
  id        String       @id @default(cuid())
  accountId String
  account   BrandAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform  Platform
  handle    String

  /// Publisher-side channel id (Postiz calls this an "integration" id).
  externalId String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  scheduledPosts ScheduledPost[]

  @@unique([accountId, platform])
  @@index([accountId])
}

model Pillar {
  id        String       @id @default(cuid())
  accountId String
  account   BrandAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  position  Int          @default(0)

  ideas Idea[]
  posts Post[]

  @@unique([accountId, name])
}

model Idea {
  id        String       @id @default(cuid())
  accountId String
  account   BrandAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pillarId  String?
  pillar    Pillar?      @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  title     String
  angle     String       @db.Text

  /// Suggested style id — carousel | reel | story | single | photo
  format    String?
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------------
// Assets library
// ---------------------------------------------------------------------------

enum AssetKind {
  photo
  screen
  logo
  video
  audio
}

model Asset {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String?
  account     BrandAccount? @relation("AccountAssets", fields: [accountId], references: [id], onDelete: SetNull)

  name       String
  kind       AssetKind
  url        String
  storageKey String?
  mimeType   String?
  width      Int?
  height     Int?
  bytes      Int?

  /// True when produced by fal.ai / ElevenLabs rather than uploaded.
  ai        Boolean  @default(false)
  prompt    String?  @db.Text
  costCents Int      @default(0)
  meta      Json?
  createdAt DateTime @default(now())

  brandLogoFor BrandAccount[] @relation("BrandLogo")
  voiceForPost Post[]         @relation("PostVoice")

  @@index([workspaceId, createdAt])
  @@index([accountId, kind])
}

// ---------------------------------------------------------------------------
// Posts — the draft the Create wizard assembles
// ---------------------------------------------------------------------------

enum PostStatus {
  draft
  rendering
  review
  scheduled
  published
  failed
}

enum Narration {
  verbatim
  condensed
}

model Post {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     BrandAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Template style id: carousel | reel | story | single | photo
  style String
  /// Cover archetype kind id, e.g. "1a-knockout"
  archetype String

  topic    String? @db.Text
  pillarId String?
  pillar   Pillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)

  /// The agent's research that produced this post — auditable when a post reads oddly.
  brief String? @db.Text

  /// "ui" | "agent". Agents may only mutate posts they created.
  createdVia String @default("ui")

  /// Which agent token created it. Null for UI-created posts.
  apiTokenId String?
  apiToken   ApiToken? @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)

  /// The full PostDoc: { slides:[{kind,f}], caption, first, hashtags, linkSticker, mention }.
  /// The manifests own this shape — see lib/templates/types.ts.
  doc Json

  // Denormalised from `doc` for listing, search and publishing.
  caption      String   @default("") @db.Text
  firstComment String   @default("") @db.Text
  hashtags     String[] @default([])

  status    PostStatus @default(draft)
  costCents Int        @default(0)

  // Voice (Reels/Stories)
  voiceId      String?
  narration    Narration @default(verbatim)
  voiceAssetId String?
  voiceAsset   Asset?    @relation("PostVoice", fields: [voiceAssetId], references: [id], onDelete: SetNull)

  /// Rendered slide/frame URLs in slide order, produced by the render service.
  mediaUrls String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renderJobs     RenderJob[]
  scheduledPosts ScheduledPost[]
  jobs           Job[]

  @@index([workspaceId, updatedAt])
  @@index([accountId, status])
  @@index([apiTokenId, createdAt])
}

enum JobKind {
  slides
  reel
  voice
}

enum JobStatus {
  queued
  running
  done
  failed
}

model RenderJob {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind        JobKind
  status      JobStatus @default(queued)
  progress    Int       @default(0)
  workerJobId String?
  error       String?   @db.Text

  /// Worker result payload — rendered urls, durations, sizes.
  outputs   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
}

enum ScheduleStatus {
  pending
  scheduled
  published
  failed
}

model ScheduledPost {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  scheduledAt    DateTime
  provider       Provider
  providerPostId String?
  status         ScheduleStatus @default(pending)

  /// Guards against double-publishing on retry.
  idempotencyKey String  @unique
  error          String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledAt, status])
  @@index([postId])
}

// ---------------------------------------------------------------------------
// Agent MCP surface — bearer tokens and server-minted job handles for
// agent-driven drafting, media generation and rendering.
// ---------------------------------------------------------------------------

/// A bearer credential letting one external agent drive this workspace.
/// The plaintext is shown once at creation and never stored.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Display name, one per client: "Hermes cron", "Claude web".
  name String

  /// sha256 hex of the full "rss_…" token. The only lookup key.
  tokenHash String @unique
  /// First 12 chars of the token, for identifying it in the UI.
  prefix    String

  /// Granted scopes: "draft" | "media" | "render". "publish" is reserved, never issued.
  scopes String[]

  /// Rolling-24h ceilings. A leaked token has a bounded daily blast radius.
  dailyCapCents Int @default(500)
  dailyDraftCap Int @default(5)

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  posts Post[]
  jobs  Job[]

  @@index([workspaceId, createdAt])
}

/// A server-minted handle for slow work the agent polls, covering both media
/// generation and rendering. Protocol 2026-07-28 specifies exactly this shape:
/// server-minted handles passed back as ordinary tool arguments.
model Job {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  apiTokenId  String?
  apiToken    ApiToken? @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)

  /// "media" | "render"
  kind String
  /// "queued" | "running" | "done" | "failed"
  state String @default("queued")

  total Int @default(0)
  done  Int @default(0)

  /// [{ slideIndex, slotId, assetId, url }] for media; [{ url }] for render.
  results Json @default("[]")
  /// [{ slideIndex, slotId, message }]
  errors  Json @default("[]")

  /// What this job spent with fal.ai / ElevenLabs, in cents.
  ///
  /// The spend ledger lives here rather than on Post because a job is created at
  /// the moment money is spent. Summing Post.costCents over a rolling window
  /// would miss repeated media calls against an older post — which is exactly
  /// the unbounded loop the cap exists to stop.
  costCents Int @default(0)

  /// Set when the background task picks it up. A queued/running job older than
  /// 10 minutes is presumed lost to a restart and reported failed.
  startedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([postId, kind])
  @@index([apiTokenId, createdAt])
}
